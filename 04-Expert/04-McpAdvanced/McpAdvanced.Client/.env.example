# ==============================================================================
# MCP Advanced Client - Environment Variables
# ==============================================================================
# Salin file ini menjadi .env dan isi dengan API key Anda.
# File .env TIDAK boleh di-commit ke version control.
# ==============================================================================

# OpenAI API Key (digunakan oleh Sampling handler untuk LLM completion)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Atau gunakan Azure OpenAI:
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_KEY=your-azure-openai-api-key-here
# AZURE_OPENAI_DEPLOYMENT=your-deployment-name
